{
  "name": "civicops-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start": "ng serve --host 0.0.0.0",
    "build": "ng build --configuration production",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint \"src/**/*.{ts,html}\" && tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.spec.json",
    "format": "prettier --write \"src/**/*.{ts,html,css,json}\" \"*.{json,mts}\"",
    "format:check": "prettier --check \"src/**/*.{ts,html,css,json}\" \"*.{json,mts}\""
  },
  "dependencies": {
    "@angular/common": "21.2.23",
    "@angular/compiler": "21.2.23",
    "@angular/core": "21.2.23",
    "@angular/forms": "21.2.23",
    "@angular/platform-browser": "21.2.23",
    "@angular/router": "21.2.23",
    "rxjs": "~7.8.1",
    "tslib": "^2.8.1",
    "zone.js": "~0.16.3"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "^2.7.2",
    "@analogjs/vitest-angular": "^2.7.2",
    "@angular-devkit/build-angular": "21.2.23",
    "@angular/build": "21.2.23",
    "@angular/cli": "21.2.23",
    "@angular/compiler-cli": "21.2.23",
    "@angular/platform-browser-dynamic": "21.2.23",
    "angular-eslint": "^21.4.0",
    "eslint": "^9.35.0",
    "jsdom": "^28.1.0",
    "prettier": "^3.5.3",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.26.0",
    "vite": "^7.3.6",
    "vitest": "^4.1.11"
  }
}
