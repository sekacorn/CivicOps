# Copy to .env for local Docker development. Use a strong unique value outside local development.
CIVICOPS_DATABASE_PASSWORD=change-me-for-local-development
# At least 32 bytes. Generate a unique random value; never reuse this placeholder outside local setup.
CIVICOPS_JWT_SECRET=replace-with-at-least-32-random-characters
CIVICOPS_ACCESS_TOKEN_TTL=PT15M
CIVICOPS_REFRESH_TOKEN_TTL=P30D
