# Copy to .env for local Docker development. Replace every placeholder before running.
# Use a strong unique database password. Do not commit .env.
CIVICOPS_DATABASE_PASSWORD=replace-with-a-strong-random-database-password
# At least 32 bytes. Generate a unique random value; never reuse this placeholder.
CIVICOPS_JWT_SECRET=replace-with-a-base64-encoded-random-jwt-secret-at-least-32-bytes
CIVICOPS_ACCESS_TOKEN_TTL=PT15M
CIVICOPS_REFRESH_TOKEN_TTL=P30D
